# Chỉ dùng các giá trị mẫu này trên máy phát triển.
POSTGRES_USER=agent_platform
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=agent_platform
POSTGRES_PORT=5432
DATABASE_URL=postgres://agent_platform:change-me-local-only@127.0.0.1:5432/agent_platform?sslmode=disable
HTTP_ADDR=127.0.0.1:8080
APP_ENV=dev
LOG_LEVEL=info

# Sinh riêng từng giá trị bằng: openssl rand -base64 32
# Ba khóa phải giữ ổn định giữa các lần khởi động; không commit giá trị thật.
JWT_SIGNING_KEY=change-me
APP_ENCRYPTION_KEY=change-me
API_KEY_PEPPER=change-me
JWT_ISSUER=agent-platform
JWT_AUDIENCE=agent-platform-admin
CORS_ORIGINS=http://localhost:5173
# Hostname chính xác hoặc CIDR, ngăn cách bằng dấu phẩy (ví dụ ai.internal,10.20.0.0/16).
# Ngoài dev yêu cầu HTTPS; metadata/link-local luôn bị chặn.
EGRESS_ALLOWLIST=
WORKER_ENABLED=true
WORKER_CONCURRENCY=4
OTEL_EXPORTER_OTLP_ENDPOINT=
